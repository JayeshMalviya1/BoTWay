{
  "name": "botway-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "botway-core",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run prisma:generate --workspace=botway-core",
    "start": "npm run start:prod --workspace=botway-core",
    "dev:backend": "npm run dev --workspace=botway-core",
    "dev:frontend": "npm run dev --workspace=frontend",
    "test": "npm run test --workspace=botway-core"
  },
  "keywords": ["botway", "chatbot", "saas", "ai"],
  "license": "UNLICENSED"
}
